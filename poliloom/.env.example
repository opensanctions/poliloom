# Logging configuration
#LOG_LEVEL=INFO

# Database configuration
# For local development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poliloom
DB_USER=postgres
DB_PASSWORD=postgres

# Database connection timeout in seconds (default: 30)
# Set higher for large migrations (e.g., 3600 for 1 hour)
DB_POOL_TIMEOUT=30

# OpenAI API (for data extraction)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-5.4-mini
# Reasoning effort for free-form extraction (default: low)
# OPENAI_REASONING_EFFORT=none
# Reasoning effort for entity mapping (default: medium)
# OPENAI_MAPPING_REASONING_EFFORT=medium

# MediaWiki OAuth (for API authentication)
# MEDIAWIKI_CONSUMER_KEY=your-consumer-key
# MEDIAWIKI_CONSUMER_SECRET=your-consumer-secret

# Google Cloud Storage (for dump processing)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Archive storage (for web page archiving)
# POLILOOM_ARCHIVE_ROOT=./archives

# Wikidata API (for statement creation)
# WIKIDATA_API_ROOT=https://www.wikidata.org/w/rest.php/wikibase/v1

# Per-source re-enrichment age and stats coverage window in days (default: 365)
# ENRICHMENT_COOLDOWN_DAYS=365

# Minutes a user's claim on review properties stays live (default: 30)
# CLAIM_TTL_MINUTES=30

# API server configuration
# Number of uvicorn worker processes (default: 8)
# WORKERS=8

# Meilisearch configuration
MEILI_URL=http://localhost:7700
# MEILI_MASTER_KEY=your-secure-master-key-here
